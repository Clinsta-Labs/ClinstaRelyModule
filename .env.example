# Database (required for producer/replay)
DATABASE_URL=postgresql+asyncpg://outbox:outbox@localhost:5432/outbox
# Optional override:
# OUTBOX_DATABASE_URL=postgresql+asyncpg://outbox:outbox@localhost:5432/outbox

OUTBOX_TABLE_NAME=outbox_event

# Replay
OUTBOX_REPLAY_ENABLED=false
OUTBOX_REPLAY_WORKER_COUNT=10
OUTBOX_REPLAY_POLL_INTERVAL_MS=1000
OUTBOX_REPLAY_PROCESSING_TIMEOUT_MS=60000
OUTBOX_REPLAY_MAX_RETRY_COUNT=5
OUTBOX_REPLAY_INITIAL_RETRY_DELAY_MS=10000
OUTBOX_REPLAY_RETRY_BACKOFF_MULTIPLIER=2
OUTBOX_REPLAY_MAX_RETRY_DELAY_MS=900000
OUTBOX_REPLAY_RETRY_JITTER=true

# HTTP
OUTBOX_REPLAY_HTTP_CONNECT_TIMEOUT_MS=5000
OUTBOX_REPLAY_HTTP_READ_TIMEOUT_MS=30000
OUTBOX_REPLAY_HTTP_TOTAL_TIMEOUT_MS=60000

# Logging
OUTBOX_REPLAY_LOG_PAYLOAD=false

# Admin API (required when mounting FastAPI admin router)
OUTBOX_ADMIN_API_KEY=change-me-in-production

# Static headers forwarded on every replay HTTP call
# OUTBOX_REPLAY_HEADER_X_SERVICE_NAME=pharmacy
# OUTBOX_REPLAY_HEADER_AUTHORIZATION=Bearer secret

# EventType → Endpoint mapping (discovered automatically)
# OUTBOX_REPLAY_ENDPOINT_CUSTOMER_INVOICE=http://accounting/internal/customer/invoice
# OUTBOX_REPLAY_ENDPOINT_CUSTOMER_PAYMENT=http://accounting/internal/customer/payment

# Optional per-event timeouts
# OUTBOX_REPLAY_TIMEOUT_CUSTOMER_INVOICE_MS=60000
